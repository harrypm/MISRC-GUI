+static int r82xx_write_manual_vga(struct r82xx_priv *priv, uint8_t index)
+{
+	uint8_t *shadow = &priv->regs[0x0c - REG_SHADOW_START];
+	uint8_t previous = *shadow;
+	int rc = r82xx_write_reg_mask(priv, 0x0c, index, 0x9f);
+
+	/* A failed I2C write must remain retryable despite shadow caching. */
+	if (rc < 0)
+		*shadow = previous;
+	return rc;
+}
+
+int r82xx_set_manual_vga_index(struct r82xx_priv *priv, uint8_t index)
+{
+	int rc = r82xx_write_manual_vga(priv, index);
+
+	if (rc == 0)
+		priv->manual_vga_index = index;
+	return rc;
+}

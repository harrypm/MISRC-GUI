#!/usr/bin/env bash
# Cross pkg-config wrapper for Android arm64-v8a builds.
#
# Used by the Meson cross-file (android/aarch64-linux-android.ini) as the
# `pkg-config` binary. It forces PKG_CONFIG_LIBDIR to the cross deps prefix
# (DEPS_PREFIX) so Meson's dependency('xxx') lookups resolve the cross-built
# vendored libs (libFLAC, fftw3f, soxr, libusb, hsdaoh, raylib) and NEVER the
# host system .pc files (which would silently link x86_64 libs into arm64).
#
# Env:
#   DEPS_PREFIX - cross deps install prefix (required)
#
# It also sets PKG_CONFIG_SYSROOT_DIR to empty (the NDK sysroot is already
# baked into the .pc files we generate for the cross deps) and disables the
# system builtin path.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Prefer an explicit DEPS_PREFIX env var if set; otherwise derive it from this
# script's location (android/ -> ../.deps/install-android-arm64). Deriving it
# makes the wrapper SELF-CONTAINED so Meson can invoke it as the cross
# pkg-config binary without any environment setup (Meson does not inherit our
# shell env when it spawns the binary, so requiring DEPS_PREFIX broke it).
if [[ -z "${DEPS_PREFIX:-}" ]]; then
  DEPS_PREFIX="$(cd -- "$SCRIPT_DIR/../.deps/install-android-arm64" && pwd)"
fi

export PKG_CONFIG_LIBDIR="$DEPS_PREFIX/lib/pkgconfig:$DEPS_PREFIX/lib64/pkgconfig"
# Empty PKG_CONFIG_PATH so a host-set value can never re-introduce x86_64 .pc
# files after PKG_CONFIG_LIBDIR. pkg-config searches LIBDIR then PATH; with
# PATH empty only the cross prefix is visible.
export PKG_CONFIG_PATH=
export PKG_CONFIG_SYSROOT_DIR=/
# Do not fall back to the host's default search paths.
exec pkg-config --static "$@"

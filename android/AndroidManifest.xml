<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.misrc.gui"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- CAMERA permission: REQUIRED for USB Host access to UVC-class devices
         (the MS2130/MS2131 are USB Video Class devices). On Android API 28+
         (we target 34), UsbManager.requestPermission() for a USB_CLASS_VIDEO
         device silently refuses to show any dialog unless the app also holds
         android.permission.CAMERA. CAMERA is a dangerous (runtime) permission
         on API 23+, so MainActivity requests it at runtime before requesting
         USB permission. Without this, no USB permission prompt ever appears. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- MISRC GUI requires OpenGL ES 3.0 (raylib rcore_android + rlgl ES3 paths) -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Touchscreen is required (the GUI is touch-compatible) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- USB Host for hsdaoh/MS2130 RF capture. Required=true so the APK is only
         offered to devices with USB host (the capture hardware needs it); this
         also gates Google Play visibility. The fd-grant flow is in MainActivity. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <application
        android:label="MISRC"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- MainActivity (dev.misrc.gui) extends android.app.NativeActivity.
             Android loads libmisrc_gui.so and calls ANativeActivity_onCreate
             (provided by raylib rcore_android.c), which sets up
             EGL/ANativeWindow and calls the app's main(). A concrete Java
             subclass (not the bare framework NativeActivity) ensures the APK
             ships a classes.dex so the installer accepts it, and is the future
             JNI hook for storage/USB. -->
        <activity
            android:name="dev.misrc.gui.MainActivity"
            android:label="MISRC"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|fontScale|uiMode|navigation"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- Tell NativeActivity which .so to load (without the lib prefix / .so suffix) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="misrc_gui" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launch MISRC when a known hsdaoh USB device is plugged in, and
                 surface the permission dialog. device_filter.xml lists the
                 MS2130/MS2131 VID/PID. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>

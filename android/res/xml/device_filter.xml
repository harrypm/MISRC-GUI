<?xml version="1.0" encoding="utf-8"?>
<!--
  USB device filter for the MISRC GUI Android build.

  Listed devices trigger the "Open MISRC" chooser when plugged in (via the
  USB_DEVICE_ATTACHED intent-filter in AndroidManifest.xml) and are the targets
  of the in-app UsbManager permission request in MainActivity.

  VID/PID mirror the known_devices table in third_party/hsdaoh/src/libhsdaoh.c.
-->
<resources>
    <usb-device vendor-id="13407" product-id="8496" />  <!-- 0x345f:0x2130 MS2130 -->
    <usb-device vendor-id="21325" product-id="8496" />  <!-- 0x534d:0x2130 MS2130 OEM -->
    <usb-device vendor-id="13407" product-id="8497" />  <!-- 0x345f:0x2131 MS2131 -->
</resources>

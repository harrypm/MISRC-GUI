# Build output dirs
/build/
/build-android/
/build-gha/
/build-local/
/build-ios/
/build-ios-sim/
/builddir/
/dist/
/misrc_tools/build/

# Vendored dependency build/install staging
/.deps/

# CI artifact output
/.ci-artifacts/

# Python bytecode from running the python-driven tests/guards
__pycache__/

# Scratch
/.tmp/

# Android debug keystore (generated, never committed)
/android/debug.keystore
# Android Meson cross-file is auto-generated by android/gen-cross-file.sh with
# machine-specific NDK + DEPS_PREFIX paths. Never commit it (it dirty-tags the
# version string on any other host/CI). Run gen-cross-file.sh before meson.
/android/aarch64-linux-android.ini
# Android deps-versions.txt is auto-generated by android/build-deps-android.sh
# with a build timestamp + the host NDK path. Never commit it for the same
# reason: regenerating it on CI dirties the tree and tags the version -dirty.
/android/deps-versions.txt

# iOS Meson cross-files are auto-generated by ios/gen-cross-file.sh with
# machine-specific Xcode SDK paths. Same rule as the Android cross-file.
/ios/aarch64-ios.ini
/ios/aarch64-ios-sim.ini
# iOS deps-versions.txt is auto-generated by ios/build-deps-ios.sh (timestamp
# + host Xcode paths); same rule as the Android one.
/ios/deps-versions.txt
# Generated per-slice pkg-config wrappers + cmake toolchain files
/ios/.gen/
# Simulator screenshot evidence captured by ios/build-app-ios.sh
/ios/screenshot*.png

# Local restore-point zips (large; never commit)
/restore_points/

# macOS Finder junk
.DS_Store
